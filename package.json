{
  "name": "colormatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "typecheck": "astro check && tsc --noEmit -p functions/tsconfig.json",
    "lint": "eslint src functions tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "functions:build": "wrangler pages functions build --outdir .wrangler/fn-build",
    "db:migrate:local": "wrangler d1 migrations apply color_palette_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply color_palette_db --remote"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@cloudflare/workers-types": "^5.20260915.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "astro": "^7.3.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.132.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260915.1": true
  }
}
