---
import { RIVALS_CHECKED, rivalColumns, rivals, type RivalId } from '../lib/rivals';

interface Props {
  /** Tools in reading order; the page's subject usually goes first. */
  ids: RivalId[];
  cardPrice: string;
  caption: string;
}

const { ids, cardPrice, caption } = Astro.props;
const all = rivals(cardPrice);
const tools = ids.map((id) => all[id]);
const headingId = `rivals-${caption.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`;
---

<section class="rivals" aria-labelledby={headingId}>
  <h2 id={headingId}>{caption}</h2>
  <div class="rivals__scroll" tabindex="0" role="region" aria-labelledby={headingId}>
    <table class:list={["rivals-table", tools.length <= 2 && "rivals-table--fit"]} style={`--tool-count: ${tools.length}`}>
      <thead>
        <tr>
          <th scope="col" class="rivals-table__corner"><span class="visually-hidden">Criterion</span></th>
          {
            tools.map((tool) => (
              <th scope="col">
                {tool.id === 'colormatch' ? (
                  tool.name
                ) : (
                  <a href={tool.url} rel="nofollow noopener" target="_blank">
                    {tool.name}
                  </a>
                )}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          rivalColumns.map((column) => (
            <tr>
              <th scope="row">{column.label}</th>
              {tools.map((tool) => (
                <td>{tool[column.key]}</td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="note">
    Checked on {RIVALS_CHECKED} on each tool's own site, running each one once. "By their statement" marks what happens
    on their servers, which nobody outside can test.
  </p>
</section>
