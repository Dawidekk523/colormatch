---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PaidResult } from '../components/PaidResult';
---

<BaseLayout
  title="Your colour card | colormatch"
  description="Open the colour card made from your colormatch result."
  path="/result/"
  noindex
>
  <section class="section">
    <div class="shell stack-lg">
      <div class="narrow stack">
        <h1>Your colour card</h1>
      </div>

      <PaidResult client:load />
    </div>
  </section>
</BaseLayout>
