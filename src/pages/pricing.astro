---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { UpgradeButton } from '../components/UpgradeButton';

// Matches the Polar product (ColorMatch Personal Color Analysis, $9.99).
// PUBLIC_CARD_PRICE in the Pages build environment overrides it, so a price
// change does not need a code change.
const cardPrice = import.meta.env.PUBLIC_CARD_PRICE ?? '$9.99';

const productSchema = [
  {
    '@type': 'Product',
    name: 'colormatch full colour report',
    description:
      'The whole reading: three measured axes with numbers, your subtype out of the twelve with its own palette, a match score for all four seasons, every colour measured, shopping rules, and the palette as a picture to share or print.',
    brand: { '@type': 'Brand', name: 'colormatch' },
    offers: {
      '@type': 'Offer',
      price: cardPrice.replace(/[^0-9.]/g, ''),
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      url: 'https://getcolormatch.com/pricing/',
    },
  },
];

const faq = [
  {
    question: 'Will the free colour report stay free?',
    answer:
      'Yes. Your season, your palette, your neutrals and the colours to be careful with are free, and there is no sign-up to see them.',
  },
  {
    question: 'What does the full report add?',
    answer:
      'The free result is the first five parts of a twelve-part report. The rest is the reading behind it: your three measurements with numbers, which of the twelve subtypes you are, how close the other three seasons came, every colour measured with its hex, RGB, lightness and intensity, the rules for metals, whites, denim, lip colour, prints and hair, a picture of the whole palette to save or share, and a printable card. The season itself is not paid for — that stays free.',
  },
  {
    question: 'Can I share the report?',
    answer:
      'Yes. The report exports as a single picture, tall for a phone or wide for a screen, with your season, your measurements and every colour in the palette. It also prints on one page.',
  },
  {
    question: 'Do I need an account to open my card?',
    answer:
      'No. After payment the card opens straight away, and the receipt email holds a link that opens the same card on any device. Keep that email — the link is the only way back, because there is nothing to sign in to.',
  },
];
---

<BaseLayout
  title="Plans and Pricing | colormatch"
  description="Your season, your palette and the colours to avoid are free. The full colormatch report adds your measurements, your subtype out of the twelve, every colour measured and a picture to share."
  path="/pricing/"
  schema={productSchema}
  breadcrumbs={[{ name: 'Home', path: '/' }]}
  faq={faq}
>
  <section class="section">
    <div class="shell stack-lg">
      <div class="narrow stack">
        <h1>Plans</h1>
        <p class="lede">
          Finding your colours costs nothing and always will. The full report is for people who want the
          reading behind the season — the numbers, the subtype, every colour measured, and something to take
          with them when they shop.
        </p>
      </div>

      <div class="upgrade">
        <div class="plan">
          <h2>Free</h2>
          <p class="plan__price">$0</p>
          <ul class="plan__list">
            <li><Icon name="included" size={20} />Your colour season from a photo or the quiz</li>
            <li><Icon name="included" size={20} />Your possible undertone</li>
            <li><Icon name="included" size={20} />Ten colours to wear, with names and colour codes</li>
            <li><Icon name="included" size={20} />Four everyday neutrals</li>
            <li><Icon name="included" size={20} />Five colours to be careful with</li>
            <li><Icon name="included" size={20} />No account, no email address, nothing uploaded</li>
          </ul>
          <a class="btn btn--secondary btn--block" href="/">Get your colours</a>
        </div>

        <div class="plan plan--tint">
          <h2>Full report</h2>
          <p class="plan__price">{cardPrice}</p>
          <ul class="plan__list">
            <li><Icon name="included" size={20} />Everything in the free plan</li>
            <li><Icon name="measurements" size={20} />Your three measurements, scored, with what each one means</li>
            <li><Icon name="subtype" size={20} />Your subtype out of the twelve, and the season it leans towards</li>
            <li><Icon name="seasonFit" size={20} />A match score for all four seasons</li>
            <li><Icon name="colours" size={20} />Every colour measured: hex, RGB, lightness and intensity</li>
            <li><Icon name="wardrobe" size={20} />Metals, whites, denim, lip colour, prints and hair colour</li>
            <li><Icon name="picture" size={20} />The palette as a picture to share, tall or wide, and a printable card</li>
            <li><Icon name="included" size={20} />One payment, no subscription</li>
          </ul>
          <UpgradeButton client:load />
        </div>
      </div>

      <section class="stack narrow">
        <h2>Questions about the plans</h2>
        <div class="faq">
          {
            faq.map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))
          }
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
