---
import BaseLayout from '../layouts/BaseLayout.astro';
import UndertoneSection from '../components/UndertoneSection.astro';
import { UNDERTONE_PAGES } from '../lib/undertone-pages';
import { UNDERTONE_GROUPS } from '../lib/undertones';

const page = UNDERTONE_PAGES.warm;
const group = UNDERTONE_GROUPS.warm;
---

<BaseLayout
  title={page.title}
  description={page.description}
  path={`/${group.slug}/`}
  faq={page.faq}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Skin tone', path: '/skin-tone-colors/' }]}
>
  <UndertoneSection id="warm" />
</BaseLayout>
