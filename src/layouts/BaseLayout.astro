---
import '../styles/global.css';
import '../styles/app.css';

interface Crumb {
  name: string;
  path: string;
}

interface Props {
  title: string;
  description: string;
  /** Path with a trailing slash, e.g. "/color-seasons/". */
  path: string;
  faq?: { question: string; answer: string }[];
  /** For pages that exist for one visitor only, like a bought result. */
  noindex?: boolean;
  /** Share card, under /og/. Falls back to the brand one. */
  image?: string;
  /** Everything above this page, excluding the page itself. */
  breadcrumbs?: Crumb[];
  /** What this page is called in a breadcrumb, when the title is too long. */
  crumb?: string;
  /** Extra JSON-LD for what this page in particular is. */
  schema?: Record<string, unknown>[];
}

const { title, description, path, faq, noindex, image, breadcrumbs, crumb, schema = [] } = Astro.props;
const here = crumb ?? title.split(' | ')[0]!;
const canonical = new URL(path, Astro.site).href;
const shareImage = new URL(image ?? '/og/default.png', Astro.site).href;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/color-analysis-quiz/', label: 'Quiz' },
  { href: '/color-palette-from-image/', label: 'From a photo' },
  { href: '/color-seasons/', label: 'The four seasons' },
  { href: '/find-my-color-palette/', label: 'How to find yours' },
];

const origin = new URL('/', Astro.site).href;

/**
 * One graph per page rather than a pile of separate blocks: the organisation
 * and the site are the same two things everywhere, and anything the page adds
 * hangs off them by reference.
 */
const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': `${origin}#organisation`,
    name: 'colormatch',
    url: origin,
    logo: new URL('/web-app-manifest-512x512.png', Astro.site).href,
  },
  {
    '@type': 'WebSite',
    '@id': `${origin}#website`,
    name: 'colormatch',
    url: origin,
    publisher: { '@id': `${origin}#organisation` },
    inLanguage: 'en',
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#page`,
    url: canonical,
    name: title,
    description,
    isPartOf: { '@id': `${origin}#website` },
    primaryImageOfPage: shareImage,
    dateModified: new Date().toISOString(),
  },
  ...schema,
];

if (breadcrumbs?.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [...breadcrumbs, { name: here, path }].map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      item: new URL(item.path, Astro.site).href,
    })),
  });
}

if (faq) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  });
}

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        /* Large image previews and untruncated snippets are opt-in, and every
           page here has a share card worth showing. */
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="colormatch" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the main content</a>

    <header class="masthead">
      <div class="shell masthead__inner">
        <a class="wordmark" href="/">
          <img class="wordmark__mark" src="/favicon-96x96.png" alt="" width="96" height="96" />
          colormatch
        </a>
        <button
          class="nav-toggle"
          type="button"
          id="nav-toggle"
          aria-expanded="false"
          aria-controls="site-nav"
          hidden
        >
          <span class="nav-toggle__bars" aria-hidden="true"></span>
          <span class="nav-toggle__label">Menu</span>
        </button>
        <nav aria-label="Main" id="site-nav" class="site-nav">
          <ul class="nav">
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      {
        breadcrumbs?.length ? (
          <nav class="crumbs" aria-label="Breadcrumb">
            <div class="shell">
              <ol>
                {breadcrumbs.map((crumb) => (
                  <li>
                    <a href={crumb.path}>{crumb.name}</a>
                  </li>
                ))}
                <li aria-current="page">{here}</li>
              </ol>
            </div>
          </nav>
        ) : null
      }
      <slot />
    </main>

    <footer class="footer">
      <div class="shell footer__grid">
        <div>
          <h2>colormatch</h2>
          <p class="note">
            A free colour guide for choosing clothes you feel good in. Everything runs in your browser and
            your photo is never uploaded.
          </p>
        </div>
        <div>
          <h2>Find your colours</h2>
          <ul>
            <li><a href="/color-analysis-quiz/">Take the quiz</a></li>
            <li><a href="/color-palette-from-image/">Use a photo</a></li>
            <li><a href="/find-my-color-palette/">How to find your palette</a></li>
          </ul>
        </div>
        <div>
          <h2>The palettes</h2>
          <ul>
            <li><a href="/spring-color-palette/">Spring</a></li>
            <li><a href="/summer-color-palette/">Summer</a></li>
            <li><a href="/autumn-color-palette/">Autumn</a></li>
            <li><a href="/winter-color-palette/">Winter</a></li>
            <li><a href="/color-seasons/">All four, side by side</a></li>
          </ul>
        </div>
        <div>
          <h2>Skin tone</h2>
          <ul>
            <li><a href="/skin-tone-colors/">Undertone, explained</a></li>
            <li><a href="/warm-skin-tone-colors/">Warm</a></li>
            <li><a href="/cool-skin-tone-colors/">Cool</a></li>
            <li><a href="/neutral-skin-tone-colors/">Neutral</a></li>
            <li><a href="/olive-skin-tone-colors/">Olive</a></li>
          </ul>
        </div>
        <div>
          <h2>More</h2>
          <ul>
            <li><a href="/what-colors-look-good-on-me/">What colours suit me?</a></li>
            <li><a href="/color-analysis-app/">The app</a></li>
            <li><a href="/best-colors-to-wear-with-gray-hair/">Colours with grey hair</a></li>
            <li><a href="/best-colors-to-wear-to-an-interview/">Colours for an interview</a></li>
            <li><a href="/best-colors-to-wear-for-a-photoshoot/">Colours for a photoshoot</a></li>
            <li><a href="/pricing/">Plans</a></li>
          </ul>
        </div>
      </div>
      <div class="shell">
        <p class="note footer__small">
          This site gives style suggestions only. It is not a professional consultation and not a health or
          medical assessment.
        </p>
      </div>
    </footer>

    <script is:inline>
      // The menu only collapses once this runs, so a page without JavaScript
      // keeps every link visible instead of hiding them behind a dead button.
      (() => {
        const toggle = document.getElementById('nav-toggle');
        const header = document.querySelector('.masthead');
        if (!toggle || !header) return;

        const wide = window.matchMedia('(min-width: 56rem)');
        const setOpen = (open) => {
          toggle.setAttribute('aria-expanded', String(open));
          header.dataset.nav = open ? 'open' : 'closed';
        };

        toggle.hidden = false;
        setOpen(false);

        toggle.addEventListener('click', () => {
          setOpen(toggle.getAttribute('aria-expanded') !== 'true');
        });

        document.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape') return;
          if (toggle.getAttribute('aria-expanded') !== 'true') return;
          setOpen(false);
          toggle.focus();
        });

        wide.addEventListener('change', () => setOpen(false));
      })();
    </script>
  </body>
</html>
